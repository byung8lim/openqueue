<?xml version="1.0" encoding="UTF-8"?>
<!--
  openqueue-queue-domain (모듈 M02의 도메인 계층)

  - 대기열 업무 규칙(FIFO, 입장 후보 선정, 멱등성)만 담는 순수 Java 모듈이다.
  - 배치 Zone: DMZ (Queue Engine 프로세스에 포함)
  - 경계 규칙: Spring, Redis, JDBC 등 어떤 런타임 외부 의존성도 가질 수 없다.
    (enforcer의 bannedDependencies로 빌드 시 강제한다. docs/architecture/module-design.md 참조)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wbl.openqueue</groupId>
        <artifactId>openqueue-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>openqueue-queue-domain</artifactId>
    <name>OpenQueue Queue Domain</name>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- 도메인 순수성 경계: compile/runtime scope 의존성을 전부 금지한다. -->
                        <id>enforce-pure-domain-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>*:*:*:*:compile</exclude>
                                        <exclude>*:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>openqueue-queue-domain은 순수 도메인 모듈이므로 compile/runtime 외부 의존성을 가질 수 없습니다. (module-design.md 참조)</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
